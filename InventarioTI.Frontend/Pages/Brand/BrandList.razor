@page "/brands"
@inject BrandService BrandService
@inject NavigationManager Nav

<!-- ============================================================
     BrandList.razor
     Listado de marcas con botón para editar.
     ============================================================ -->

<MudPaper Class="pa-6" Elevation="2">

    <MudText Typo="Typo.h5" Class="mb-4">Listado de marcas</MudText>

    <!-- Botón para crear nueva marca -->
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               Class="mb-4"
               OnClick="@(() => Nav.NavigateTo("/brands/create"))">
        NUEVA MARCA
    </MudButton>

    <!-- Tabla de marcas -->
    <MudTable Items="brands">

        <HeaderContent>
            <MudTh>Nombre</MudTh>
            <MudTh>Descripción</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.Nombre</MudTd>
            <MudTd>@context.Descripcion</MudTd>

            <!-- Botón Editar -->
            <MudTd>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Info"
                           OnClick="@(() => Nav.NavigateTo($"/brands/edit/{context.Id}"))">
                    Editar
                </MudButton>
            </MudTd>
        </RowTemplate>

    </MudTable>

</MudPaper>

@code {

    private List<BrandDto> brands = new();

    protected override async Task OnInitializedAsync()
    {
        brands = await BrandService.GetBrandsAsync();
    }
}