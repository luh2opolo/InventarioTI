@page "/brands/edit/{id:int}"
@inject BrandService BrandService
@inject NavigationManager Nav
@using InventarioTI.Frontend.Models

<!-- ============================================================
     BrandEdit.razor
     Página para editar una marca existente.
     ============================================================ -->

<MudPaper Class="pa-6" Elevation="2" Style="max-width:500px; margin:auto;">
    <!-- ✔ max-width controla el ancho -->
    <!-- ✔ margin:auto centra el formulario -->

    <MudText Typo="Typo.h5" Class="mb-4">Editar marca</MudText>

    <MudForm @ref="form">

        <!-- Campo Nombre (sin asterisco) -->
        <MudTextField Label="Nombre"
                      @bind-Value="model.Nombre"
                      Required="false"
                      HelperText="El nombre es obligatorio" />

        <!-- Campo Descripción -->
        <MudTextField Label="Descripción"
                      @bind-Value="model.Descripcion"
                      Lines="3"
                      Placeholder="Puede quedar en blanco" />

        <MudSpacer />

        <div style="display:flex; gap:12px; margin-top:20px;">
            <!-- Botón Guardar -->
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Style="height:40px; flex:1;"
                       Elevation="3"
                       OnClick="Guardar">
                Guardar
            </MudButton>

            <!-- Botón Cancelar -->
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       Style="height:40px; flex:1;"
                       Elevation="1"
                       OnClick="Cancelar">
                Cancelar
            </MudButton>
        </div>

    </MudForm>

</MudPaper>

@code {

    [Parameter] public int id { get; set; }

    private BrandUpdateDto model = new();
    private MudForm? form;

    protected override async Task OnInitializedAsync()
    {
        var brand = await BrandService.GetBrandByIdAsync(id);

        if (brand != null)
        {
            model.Nombre = brand.Nombre;
            model.Descripcion = brand.Descripcion ?? string.Empty;
        }
    }

    private async Task Guardar()
    {
        await form!.ValidateAsync();

        if (string.IsNullOrWhiteSpace(model.Nombre))
            return;

        var ok = await BrandService.UpdateBrandAsync(id, model);

        if (ok)
            Nav.NavigateTo("/brands");
    }

    private void Cancelar()
    {
        Nav.NavigateTo("/brands");
    }
}