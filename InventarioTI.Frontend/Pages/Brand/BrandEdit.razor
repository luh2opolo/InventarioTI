@page "/brands/edit/{id:int}"
@inject BrandService BrandService
@inject NavigationManager Nav

<MudPaper Class="pa-6 mx-auto" MaxWidth="500px" Elevation="2">

    <MudText Typo="Typo.h5" Class="mb-4">Editar Marca</MudText>

    <MudForm @ref="form">

        <MudTextField Label="Nombre"
                      @bind-Value="brand.Nombre"
                      Required="true"
                      RequiredError="El nombre es obligatorio"
                      Class="mb-4" />

        <MudTextField Label="Descripción"
                      @bind-Value="brand.Descripcion"
                      Lines="3"
                      Class="mb-4" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Guardar"
                   Class="mr-2">
            Guardar
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   OnClick="@(() => Nav.NavigateTo("/brands"))">
            Cancelar
        </MudButton>

    </MudForm>

</MudPaper>

@code {
    [Parameter] public int id { get; set; }

    private BrandUpdateDto brand = new();

    // MudForm puede ser null hasta que el componente se renderice
    private MudForm? form;

    protected override async Task OnInitializedAsync()
    {
        var data = await BrandService.GetBrandByIdAsync(id);

        // ✔ Evita CS8602: data puede venir null
        if (data is null)
        {
            Nav.NavigateTo("/brands");
            return;
        }

        brand.Nombre = data.Nombre;
        brand.Descripcion = data.Descripcion ?? string.Empty; // ✔ evita null
    }

    private async Task Guardar()
    {
        // ✔ Evita CS8602: validar solo si form ya está inicializado
        if (form is null)
            return;

        await form.ValidateAsync();

        if (!form.IsValid)
            return;

        await BrandService.UpdateBrandAsync(id, brand);
        Nav.NavigateTo("/brands");
    }
}