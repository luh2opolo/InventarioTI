@inherits LayoutComponentBase
@using MudBlazor

<MudThemeProvider>
    <MudLayout>

        <MudDrawer Open="true" Elevation="1" ClipMode="DrawerClipMode.Always" Class="sidebar-container">
            <NavMenu />
        </MudDrawer>

        <MudAppBar Elevation="1" Class="header-container">
            <MudText Typo="Typo.h6">InventarioTI</MudText>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" />
        </MudAppBar>

        <MudMainContent Class="main-content">
            @Body
        </MudMainContent>

    </MudLayout>
</MudThemeProvider>