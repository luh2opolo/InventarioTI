@inherits LayoutComponentBase
@using MudBlazor

<!-- ============================================================
     MainLayout.razor
     Layout principal del sistema InventarioTI
     - Sidebar (menú lateral)
     - AppBar (barra superior)
     - Contenido principal
     - Tema corporativo MudBlazor
   ============================================================ -->

<!-- Proveedor global de tema (ACTIVADO con Theme="@theme") -->
<MudThemeProvider Theme="@theme" />

<!-- Contenedor general del layout -->
<MudLayout>

    <!-- ========================================================
         SIDEBAR (MENÚ LATERAL)
         - Usa la clase .sidebar-container del CSS
         - Contiene el componente NavMenu
       ======================================================== -->
    <MudDrawer Open="true"
               Elevation="1"
               ClipMode="DrawerClipMode.Always"
               Class="sidebar-container">

        <NavMenu />   <!-- Aquí se cargan los iconos y enlaces -->
    </MudDrawer>


    <!-- ========================================================
         APPBAR (BARRA SUPERIOR)
         - Usa la clase .header-container del CSS
         - Muestra el título del sistema
         - Incluye icono de usuario
       ======================================================== -->
    <MudAppBar Elevation="1"
               Class="header-container">

        <MudText Typo="Typo.h6">InventarioTI</MudText>

        <MudSpacer />

        <MudIconButton Icon="@Icons.Material.Filled.AccountCircle" />
    </MudAppBar>


    <!-- ========================================================
         CONTENIDO PRINCIPAL
         - Usa la clase .main-content del CSS
         - Aquí se renderiza cada página
       ======================================================== -->
    <MudMainContent Class="main-content">
        @Body
    </MudMainContent>

</MudLayout>


@code {

    /*
        ============================================================
        TEMA CORPORATIVO MUD BLAZOR (COMPATIBLE CON VERSIONES 6+)
        MudBlazor moderno usa PaletteLight y PaletteDark.
        ============================================================
    */

    private MudTheme theme = new MudTheme()
    {
        // ========================================================
        // Tema claro (Light Mode)
        // ========================================================
        PaletteLight = new PaletteLight()
        {
            Primary = "#1976d2",        // Azul corporativo
            Secondary = "#424242",      // Gris elegante
            Background = "#f5f7fa",     // Fondo gris claro moderno
            AppbarBackground = "#1976d2",
            DrawerBackground = "#ffffff",
            TextPrimary = "#212121",
            TextSecondary = "#555555"
        },

        // ========================================================
        // Tema oscuro (Dark Mode)
        // ========================================================
        PaletteDark = new PaletteDark()
        {
            Primary = "#90caf9",        // Azul claro para modo oscuro
            Secondary = "#eeeeee",
            Background = "#121212",
            AppbarBackground = "#1e1e1e",
            DrawerBackground = "#1e1e1e",
            TextPrimary = "#ffffff",
            TextSecondary = "#cccccc"
        }
    };

}